# Copia este archivo como .env.local (en tu computador) o pega estas
# variables en Vercel → Settings → Environment Variables (en internet).

# Contraseña del panel de cocina (la usa todo el equipo).
ADMIN_PASSWORD=cambiar-esta-clave

# Contraseña para Programar (solo quien administra la producción).
# También abre el panel, así que con esta sola basta para entrar a todo.
PROGRAMAR_PASSWORD=cambiar-esta-otra-clave

# Contraseña de Clientes (la base de clientes con precios y teléfonos).
# Si no se pone, Clientes se abre con la de Programar.
CLIENTES_PASSWORD=cambiar-esta-tercera-clave

# Supabase (la base de datos). Sin estas dos, todo se guarda en la carpeta
# .data del computador y solo sirve para probar.
# Las encuentras en Supabase → Project Settings → API:
#   SUPABASE_URL = "Project URL"
#   SUPABASE_SERVICE_KEY = la clave "service_role" (¡secreta! no la compartas)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
